# Maintainer: ayrton <ai@blobfish.icu>
pkgname=morog-git
pkgver=r42.98716b7
pkgrel=1
pkgdesc='Research toolkit implementing a Source-Topic-Argument note model on morg vaults'
arch=('x86_64' 'aarch64')
url='https://github.com/bloboss/morog'
license=('MIT')
depends=('gcc-libs')
makedepends=('git' 'rust')
provides=('morog')
conflicts=('morog')
# The GitHub remote does not exist yet. Until it does, build from the local
# checkout by swapping in the commented source line below.
source=("git+https://github.com/bloboss/morog.git")
# source=("git+file://$HOME/Code/Software/Morog/morog")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/morog"
    # No tags upstream yet: fall back to r<commit-count>.<short-sha> until
    # the first v* tag exists, then git describe takes over.
    (
        set -o pipefail
        git describe --long --tags --abbrev=7 2>/dev/null \
            | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
            || printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

prepare() {
    cd "$srcdir/morog"
    export RUSTUP_TOOLCHAIN=stable
    # Needs network: Cargo.lock pins morg-parser as a git dependency on
    # github.com/bloboss/morg, which cargo fetch resolves here.
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/morog"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$srcdir/morog"
    install -Dm755 target/release/morog "$pkgdir/usr/bin/morog"

    # Shell completions generated by the freshly built binary.
    target/release/morog completions zsh \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_morog"
    target/release/morog completions bash \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/morog"
    target/release/morog completions fish \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/morog.fish"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
